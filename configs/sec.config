# configs/sec.config - security diagnostic kernel: PKS on + full introspection.
# Debug counters and debugfs status are what the sanity/sec harnesses read.

CONFIG_PCACHE_PKS=y
CONFIG_PCACHE_PKS_DEBUG=y
CONFIG_PKS_TEST=y
# CONFIG_PKS_TEST_ALL_KEYS is not set

# Required for pcache_pks_fault_callback softirq instruction pointer advance
CONFIG_INSTRUCTION_DECODER=y

# Diagnostics and symbol formatting for pr_warn %pS
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# Leaving PANIC_ON_OOPS off preserves graceful fault handling under implementation-4:
# task context terminates the attacking task via make_task_dead with SIGKILL, while
# softirq context advances regs->ip past the store, neutralizing the write without
# crashing the system. Page-init hardening is disabled to prevent masking PKS faults.
# CONFIG_PANIC_ON_OOPS is not set
# CONFIG_PAGE_POISONING is not set
# CONFIG_DEBUG_PAGEALLOC is not set
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# CONFIG_INIT_ON_FREE_DEFAULT_ON is not set
# CONFIG_HIBERNATION is not set
