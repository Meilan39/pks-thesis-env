# configs/sec.config - security diagnostic kernel: PKS on + full introspection.
# Debug counters and debugfs status are what the sanity/sec harnesses read.

CONFIG_PCACHE_PKS=y
CONFIG_PCACHE_PKS_DEBUG=y
CONFIG_PKS_TEST=y
# CONFIG_PKS_TEST_ALL_KEYS is not set

# Diagnostics
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y

# A stray supervisor write must fail closed, not be silently absorbed. Leaving
# PANIC_ON_OOPS off preserves the per-context behaviour we key verdicts on:
# syscall context returns -EFAULT (VM survives), softirq/workqueue context takes
# an unhandled fault and panics. Page-init hardening is disabled so it cannot
# mask or pre-empt the PKS fault.
# CONFIG_PANIC_ON_OOPS is not set
# CONFIG_PAGE_POISONING is not set
# CONFIG_DEBUG_PAGEALLOC is not set
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# CONFIG_INIT_ON_FREE_DEFAULT_ON is not set
# CONFIG_HIBERNATION is not set
