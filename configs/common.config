# configs/common.config - shared by every guest kernel (control, sec, perf).
# Storage, VirtIO, 9p, and ALL exploit prerequisites live here so that every
# tree can host every vulnerability vector (keeps the A/B valid).

# Storage & VirtIO & 9p host share
CONFIG_EXT4_FS=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# Namespaces & network transform (exploit prerequisites)
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_XFRM=y
CONFIG_XFRM_USER=y
CONFIG_NET_KEY=y
CONFIG_INET_ESP=y
CONFIG_INET_ESPINTCP=y
CONFIG_INET6_ESP=y
CONFIG_INET6_ESPINTCP=y

# Crypto (AF_ALG splice + IPsec/ESP + RxRPC fallback paths)
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AUTHENC=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_AF_RXRPC=y
CONFIG_RXKAD=y
CONFIG_CRYPTO_FCRYPT=y
CONFIG_CRYPTO_PCBC=y
