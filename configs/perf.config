# configs/perf.config - mitigated performance kernel: PKS on, diagnostics off.
# Production-optimized fast paths so measured overhead reflects hardware MSR
# switching, not diagnostic instrumentation.

CONFIG_PCACHE_PKS=y
CONFIG_INSTRUCTION_DECODER=y

# Strip all diagnostic overhead
# CONFIG_PCACHE_PKS_DEBUG is not set
# CONFIG_PKS_TEST is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_PROVE_LOCKING is not set
# CONFIG_KASAN is not set
# CONFIG_PAGE_POISONING is not set
# CONFIG_DEBUG_PAGEALLOC is not set
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# CONFIG_INIT_ON_FREE_DEFAULT_ON is not set
# CONFIG_HIBERNATION is not set
