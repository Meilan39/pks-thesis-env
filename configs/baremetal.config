# configs/baremetal.config - extra drivers so a control/sec/perf kernel can boot
# on REAL hardware. The common/sec/perf fragments target virtio only (QEMU), so
# a stock build will not find root on a physical box. Merged LAST, after the
# variant fragment, only when building with BAREMETAL=1 (see build/build_kernel.sh).
#
# This list is a starting point for a typical x86_64 server/workstation; add the
# exact storage and NIC drivers your test box needs (check `lspci -k` on it).

# --- Storage controllers (root device) ---
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_NVME=y
CONFIG_MEGARAID_SAS=y

# --- Common NICs (needed for ssh/netconsole/package refresh) ---
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IXGBE=y
CONFIG_R8169=y
# Broadcom NetXtreme-E (BCM57416 [14e4:16d8], bnxt_en) -- the eval box's ACTUAL NIC
# (enp108s0f0np0 / enp108s0f1np1). There is NO Mellanox hardware on this box; the
# mlx5 lines added via merge were a misdiagnosis and have been removed. Without bnxt
# the test kernels have no network.
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_BNXT=y

# --- Physical console & input ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_VT=y
CONFIG_VGA_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# UEFI boots have no VGA text mode; the EFI framebuffer feeds the BMC remote console
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_EFIVAR_FS=y

# --- Crash-proof remote capture (recommended for unattended sec sweeps) ---
CONFIG_NETCONSOLE=y

# --- Hardware watchdog: auto-reset a wedged boot during an unattended sweep ---
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
# The core alone has no device; HPE iLO [103c:3306] is driven by hpwdt
CONFIG_HP_WATCHDOG=y

# --- CPU frequency control for perf hygiene (governor=performance) ---
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_X86_INTEL_PSTATE=y
# defconfig leaves intel_idle off (no default), which makes intel_idle.max_cstate= a no-op
CONFIG_CPU_IDLE=y
CONFIG_INTEL_IDLE=y

# --- Expose the running .config for substrate auto-detection (/proc/config.gz) ---
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Toolchain: this server is Ubuntu 24.04 (gcc 13); v5.18-rc3 predates it and
# trips new, benign warnings (-Wdangling-pointer/-Warray-bounds/-Waddress/-Wformat)
# that CONFIG_WERROR turns into hard build failures. The original QEMU builds used
# gcc 11.4, which does not emit them. Dropping WERROR keeps them warnings so the
# build completes; codegen is unchanged, and all three variants share this host's
# compiler so the control/off/on comparison stays internally consistent.
# CONFIG_WERROR is not set
