# Kernel build trees live in the external source dirs, never committed.
build_*/
images/*.img

# Generated evaluation artifacts.
# Top-level summaries + provenance.
results/*.log
results/*.json
results/.substrate
results/data/*
# In-tree raw + rolled-up results (raw next to producers; result.log per node).
**/result.log
**/raw.log
**/raw-*.log
**/raw/

# Compiled in-guest binaries (rebuilt lazily by each leaf run.sh).
test/fsx/fsx
test/pjd/pjdfstest
test/sanity/pks_sanity_test
test/pks-unit/test_pks
sec/dirty-frag/exp
sec/fragnesia/exp

__pycache__/
